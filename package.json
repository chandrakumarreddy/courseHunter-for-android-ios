{
  "name": "coursehunter-net-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "rspeedy build",
    "check": "biome check --write",
    "dev": "rspeedy dev",
    "format": "biome format --write",
    "preview": "rspeedy preview",
    "test": "rstest run",
    "dev:android": "./android/gradlew -q -p android installDebug && ANDROID_RELOAD=1 rspeedy dev",
    "build:android": "rspeedy build && ./android/gradlew -q -p android assembleRelease && cp android/app/build/outputs/apk/release/app-release.apk coursehunter.apk && echo \"APK ready: ./coursehunter.apk\""
  },
  "dependencies": {
    "@lynx-js/react": "^0.126.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@lynx-js/preact-devtools": "^5.0.1-20260827072047-5f77e12",
    "@lynx-js/qrcode-rsbuild-plugin": "^0.7.3",
    "@lynx-js/react-rsbuild-plugin": "^0.20.3",
    "@lynx-js/rspeedy": "^0.18.0",
    "@lynx-js/types": "^4.1.0",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rstest/core": "^0.12.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/react": "^19.2.18",
    "jsdom": "^27.4.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": true,
  "packageManager": "bun@1.3.14"
}
